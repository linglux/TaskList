            M 125,33 C 122,26 126,21 130,23 C 134,24 136,28 137,34
            C 133,37 128,37 125,33 Z
            M 152,59 C 150,52 153,47 157,48 C 162,49 165,53 165,59
            C 161,62 156,62 152,59 Z
            M 54,81 C 52,75 57,71 61,75 C 64,77 65,81 66,84
            C 62,87 57,85 54,81 Z
            M 98,81 C 101,83 104,83 107,81
            M 120,83 C 123,85 127,85 130,83
            M 142,88 C 145,90 149,90 152,88
        </Geometry>
        <LinearGradientBrush x:Key="ApplauseHandBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFD9B8" Offset="0" />
            <GradientStop Color="#F0BA91" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ApplauseBackHandBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0E1" Offset="0" />
            <GradientStop Color="#FFE2C7" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ApplauseCardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFEFB" Offset="0" />
            <GradientStop Color="#FFF8EB" Offset="0.65" />
            <GradientStop Color="#F2EEFF" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent" Opacity="1">
        <Rectangle x:Name="DimLayer" Fill="#080D20" Opacity="0" IsHitTestVisible="False" />

        <Grid x:Name="HaloHost" Width="260" Height="260" HorizontalAlignment="Center"
              VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse x:Name="Ring1" Width="180" Height="180" Stroke="#9C8CFF" StrokeThickness="2"
                     Fill="Transparent" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Ring2" Width="180" Height="180" Stroke="#5EEAD4" StrokeThickness="2"
                     Fill="Transparent" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Ring3" Width="180" Height="180" Stroke="#F9A8D4" StrokeThickness="2"
                     Fill="Transparent" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2" /></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False">
            <TextBlock x:Name="FloatingLabel" Text="完成!" Visibility="Collapsed" FontSize="17"
                       FontWeight="Bold" Foreground="#6C63FF" IsHitTestVisible="False">
                <TextBlock.RenderTransform>
                    <TranslateTransform />
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- 中型：局部光晕 + 光环脉冲 + 成就卡片，不做全屏暗化 -->
            <Ellipse x:Name="MediumGlow" Width="150" Height="150" Visibility="Collapsed" Opacity="0"
                     IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#666C63FF" Offset="0" />
                        <GradientStop Color="#226C63FF" Offset="0.55" />
                        <GradientStop Color="#006C63FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="MediumRing" Width="96" Height="96" Stroke="{DynamicResource AccentBrush}"
                     StrokeThickness="2.5" Visibility="Collapsed" Opacity="0"
                     IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" />

            <Grid x:Name="MediumCard" Width="268" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Border Background="White" CornerRadius="16" BorderThickness="1"
                        BorderBrush="{DynamicResource SoftBorderBrush}"
                        Effect="{DynamicResource ShadowMedium}" Padding="18,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="12"
                                    Background="{DynamicResource AccentGradient}">
                                <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPathWhite}"
                                      Width="18" Height="18" StrokeThickness="2.8" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="完成 · 中型任务" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="MediumHint" Text="稳稳推进了一步" FontSize="11"
                                           Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="MediumTaskTitle" FontSize="13" Margin="0,12,0,0"
                                   MaxWidth="232" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Height="3" CornerRadius="1.5" Background="#EEF0F9" Margin="0,14,0,0">
                            <Rectangle x:Name="MediumSweep" Width="0" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left" Fill="{DynamicResource AccentGradient}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Ellipse x:Name="ApplauseGlow" Width="280" Height="280" Visibility="Collapsed"
                     Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#90FFD993" Offset="0" />
                        <GradientStop Color="#38F6C16B" Offset="0.5" />
                        <GradientStop Color="#00F6C16B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="ApplauseWave1" Width="100" Height="100" Stroke="#E6B96C"
                     StrokeThickness="2" Visibility="Collapsed" Opacity="0"
                     RenderTransformOrigin="0.5,0.5" />
            <Ellipse x:Name="ApplauseWave2" Width="100" Height="100" Stroke="#B7A2F3"
                     StrokeThickness="1.5" Visibility="Collapsed" Opacity="0"
                     RenderTransformOrigin="0.5,0.5" />
            <Ellipse x:Name="ApplauseWave3" Width="100" Height="100" Stroke="#7AD8C6"
                     StrokeThickness="1.5" Visibility="Collapsed" Opacity="0"
                     RenderTransformOrigin="0.5,0.5" />

            <Grid x:Name="ApplauseCard" Width="292" Height="274" Visibility="Collapsed"
                  Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border Background="{StaticResource ApplauseCardBrush}" CornerRadius="22"
                        BorderBrush="#EEDFCC" BorderThickness="1" Padding="16"
                        Effect="{DynamicResource ShadowMedium}">
                    <StackPanel>
                        <TextBlock x:Name="ApplauseBadge" Text="完成 · 送给努力的你" FontSize="10"
                                   FontWeight="SemiBold" Foreground="#9A7545" HorizontalAlignment="Center" />
                        <Viewbox x:Name="ApplauseHands" Height="142" Margin="0,8,0,0" Stretch="Uniform">
                            <Canvas x:Name="ApplauseStage" Width="260" Height="190" ClipToBounds="True">
                                <Path x:Name="BackHandOutline" Data="{StaticResource ApplauseBackContour}"
                                      Fill="{StaticResource ApplauseBackHandBrush}" Stroke="#AD795A"
                                      StrokeThickness="2.2" StrokeLineJoin="Round" />
                                <Path x:Name="BackHandShading" Data="{StaticResource ApplauseBackShading}"
                                      Fill="#E5B68E" Opacity="0.30" />
                                <Path x:Name="BackHandDetails" Data="{StaticResource ApplauseBackDetails}"
                                      Stroke="#C49472" StrokeThickness="1.7" Opacity="0.65"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path x:Name="FrontHandOutline" Data="{StaticResource ApplauseFrontContour}"
                                      Fill="{StaticResource ApplauseHandBrush}" Stroke="#AD795A"
                                      StrokeThickness="2.2" StrokeLineJoin="Round" />
                                <Path x:Name="FrontHandShading" Data="{StaticResource ApplauseFrontShading}"
                                      Fill="#D9976A" Opacity="0.35" />
                                <Path x:Name="FrontHandDetails" Data="{StaticResource ApplauseFrontDetails}"
                                      Stroke="#BB8059" StrokeThickness="1.7" Opacity="0.65"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path x:Name="ApplauseSpark" Data="M 132,19 L 130,10 M 151,23 L 158,16 M 151,42 L 160,44"
                                      Stroke="#EFB258" StrokeThickness="2.6" Opacity="0"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="ApplauseHeadline" Text="为你鼓掌" FontSize="20" FontWeight="Bold"
                                   Foreground="#4C3B64" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="ApplauseTitle" FontSize="12" Foreground="#7C6A7D" Margin="0,5,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ApplauseHint" FontSize="11" Foreground="#A18A69" Margin="0,9,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Canvas>

        <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <StackPanel.RenderTransform>
                <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
            </StackPanel.RenderTransform>

            <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource WarmGradient}"
                    HorizontalAlignment="Center" Effect="{DynamicResource ShadowMedium}">
                <Path Data="{StaticResource IconSparkle}" Style="{StaticResource IconPathWhite}"
                      Width="38" Height="38" Fill="White" Stroke="White" StrokeThickness="0.6" />
            </Border>
            <TextBlock x:Name="HeadlineText" Text="任务完成" FontSize="36" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,22,0,0" />
            <TextBlock x:Name="TaskTitleText" FontSize="15" Foreground="#C9D2F5"
                       HorizontalAlignment="Center" Margin="0,12,0,0" MaxWidth="520"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="EncouragementText" FontSize="13" Foreground="#8D9BC9"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>

        <Canvas x:Name="EffectCanvas" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</UserControl>
