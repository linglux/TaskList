<UserControl x:Class="TaskList.Views.CelebrationOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" IsHitTestVisible="False" Background="Transparent">

    <UserControl.Resources>
        <Geometry x:Key="ApplauseBackContour">
            M 28,188 C 45,168 62,153 75,141 C 79,136 79,128 73,119
            C 65,108 54,101 49,88 C 45,80 45,71 51,67
            C 58,62 65,67 71,75 C 77,82 82,89 88,94
            C 87,84 90,73 94,64 C 97,53 102,43 107,35
            C 112,28 119,29 123,36 C 126,41 124,48 122,54
            C 129,39 135,24 142,17 C 149,10 159,13 161,21
            C 163,27 158,35 155,41 C 165,26 174,15 181,14
            C 191,13 196,22 191,31 C 186,40 181,46 177,53
            C 188,40 196,33 202,36 C 211,39 210,48 204,55
            C 195,66 188,77 184,87 C 180,104 174,117 166,128
            C 157,137 153,145 151,155 C 146,169 141,181 139,188
            C 102,193 64,193 28,188 Z
        </Geometry>
        <Geometry x:Key="ApplauseBackShading">
