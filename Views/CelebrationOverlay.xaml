            M 88,94 C 98,101 103,113 101,125
            M 106,96 C 123,88 144,91 154,102
            M 104,119 C 116,132 131,139 143,137
            M 93,145 C 106,153 123,157 137,155
        </Geometry>
        <Geometry x:Key="ApplauseFrontContour">
            M 102,188 C 102,163 91,145 80,132 C 71,120 60,111 55,98
            C 51,89 48,80 51,74 C 55,66 63,69 68,76
            C 73,81 78,88 81,90 C 79,75 73,49 73,32
            C 73,19 88,18 92,30 C 94,37 96,45 98,51
            C 95,34 91,21 94,13 C 99,4 110,8 113,19
            C 117,30 119,39 122,49 C 120,32 118,25 122,20
            C 128,13 138,18 140,29 C 143,40 145,49 147,59
            C 146,48 148,42 154,42 C 161,40 168,46 169,54
            C 175,73 174,89 172,108 C 171,119 169,128 169,138
            C 170,150 178,161 189,172 C 196,180 202,187 205,190
            C 173,195 133,194 102,188 Z
        </Geometry>
        <Geometry x:Key="ApplauseFrontShading">
            M 164,52 C 169,76 169,97 163,117 C 160,129 159,142 163,152
            C 169,169 184,184 191,192 C 196,192 201,191 205,190
            C 202,187 196,180 189,172 C 178,161 170,150 169,138
            C 169,128 171,119 172,108 C 174,89 175,73 169,54
            C 168,51 166,51 164,52 Z
        </Geometry>
        <Geometry x:Key="ApplauseFrontDetails">
            M 98,51 C 100,59 102,66 104,72
            M 122,49 C 124,57 126,66 126,72
            M 147,59 C 149,67 150,75 150,81
            M 77,34 C 75,27 80,23 84,25 C 88,26 89,31 90,36
            C 86,39 80,38 77,34 Z
            M 98,23 C 95,16 99,11 103,13 C 108,14 110,19 111,24
