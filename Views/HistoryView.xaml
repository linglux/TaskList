<UserControl x:Class="TaskList.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ContentBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,28,34,32">

            <TextBlock Text="历史记录" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="按天回看完成的任务，随时把前一天整理成可复制的日报" FontSize="12.5"
                       Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- 日期导航 -->
            <Border Margin="0,22,0,0" Background="White" CornerRadius="14" Padding="18,16"
                    BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1"
                    Effect="{DynamicResource ShadowSmall}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource ContentIconButtonStyle}" Width="36" Height="36"
                            Command="{Binding PrevDayCommand}" ToolTip="上一天">
                        <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource IconPath}" />
                    </Button>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DateTitle}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border CornerRadius="6" Background="#EEEFFE" Padding="8,2" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding RelativeLabel}" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatsLine}" FontSize="11.5" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ContentIconButtonStyle}" Width="36" Height="36"
                                Command="{Binding NextDayCommand}" ToolTip="下一天">
                            <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconPath}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Content="回到最近"
                                Command="{Binding LatestCommand}" Padding="12,8" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 总结入口 -->
            <Grid Margin="0,16,0,0">
                <TextBlock Text="已完成的任务" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SummaryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDocument}" Style="{StaticResource IconPathWhite}"
                              Width="15" Height="15" />
                        <TextBlock Text="生成前一天总结" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 总结文本框 -->
            <Border Margin="0,14,0,0" Padding="18,16" CornerRadius="14" Background="White"
                    BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1"
                    Effect="{DynamicResource ShadowMedium}"
                    Visibility="{Binding IsSummaryVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDocument}" Style="{StaticResource IconPath}"
                                  Stroke="{DynamicResource AccentBrush}" Width="16" Height="16" />
                            <TextBlock Text="可复制的日报文本" FontSize="13.5" FontWeight="SemiBold"
                                       Margin="9,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ContentIconButtonStyle}"
                                    Command="{Binding PrevSummaryDayCommand}" ToolTip="总结日期往前一天">
                                <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource IconPath}"
                                      Width="14" Height="14" />
                            </Button>
                            <TextBlock Text="{Binding SummaryDateTitle}" FontSize="12" VerticalAlignment="Center"
                                       Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Style="{StaticResource ContentIconButtonStyle}"
                                    Command="{Binding NextSummaryDayCommand}" ToolTip="总结日期往后一天">
                                <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconPath}"
                                      Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource ContentIconButtonStyle}"
                                    Command="{Binding CloseSummaryCommand}" ToolTip="收起总结">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}"
                                      Width="14" Height="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,12,0,0" Background="#F7F8FD" CornerRadius="10" Padding="12"
                            BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1">
                        <TextBox Text="{Binding SummaryText, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="230"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12.5"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CopyFeedback}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,12,0" Foreground="#16A34A"
                                   Visibility="{Binding CopyFeedback, Converter={StaticResource StringToVisibility}}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CopyCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPathWhite}"
                                      Width="14" Height="14" />
                                <TextBlock Text="复制全部" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 当日完成列表 -->
            <Grid Margin="0,16,0,0">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,4,10" Padding="15,13" Background="White" CornerRadius="12"
                                    BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1"
                                    Effect="{DynamicResource ShadowSmall}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26" Height="26" CornerRadius="13"
                                            Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPathWhite}"
                                              Width="13" Height="13" StrokeThickness="2.6" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="13,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Notes}" FontSize="11.5" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding Notes, Converter={StaticResource StringToVisibility}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Border CornerRadius="5" Padding="7,2" Background="{Binding WeightBackground}">
                                                <TextBlock Text="{Binding WeightText}" FontSize="10.5"
                                                           Foreground="{Binding WeightForeground}" />
                                            </Border>
                                            <TextBlock Text="{Binding GroupName}" FontSize="11" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="创建于" FontSize="11" Margin="10,0,3,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding CreatedText}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompletedTimeText}" FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <Button Content="恢复待办" Margin="0,8,0,0" FontSize="11"
                                                Style="{StaticResource TextButtonStyle}"
                                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="删除" Margin="0,2,0,0" FontSize="11"
                                                Style="{StaticResource DangerTextButtonStyle}"
                                                ToolTip="永久删除这条完成记录"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
                        Padding="22,18" CornerRadius="12" Background="#EFF1FA"
                        Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="这一天还没有完成记录，换个日期看看吧" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
