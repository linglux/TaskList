<Window x:Class="TaskList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TaskList.Views"
        xmlns:vm="clr-namespace:TaskList.ViewModels"
        xmlns:loc="clr-namespace:TaskList.Helpers"
        xmlns:services="clr-namespace:TaskList.Services"
        Language="{Binding UiLanguage, Source={x:Static services:LocalizationService.Instance}}"
        Title="{loc:Loc Key='TaskList · 专注今天'}" Icon="/Assets/AppIcon.ico"
        Width="1200" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource ContentBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="{DynamicResource ContentBrush}">
        <Grid x:Name="MainLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource TitleBarBorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="264" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <Image x:Name="TitleBarIcon" Width="28" Height="28" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True" SnapsToDevicePixels="True" />
                        <TextBlock Text="TaskList" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Foreground="{DynamicResource TitleBarTextBrush}" />
                        <Border CornerRadius="5" Background="{DynamicResource TitleBarBadgeBrush}" Padding="7,2" Margin="10,0,0,0"
                                BorderBrush="{DynamicResource TitleBarBadgeBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key='离线'}" FontSize="10" Foreground="{DynamicResource TitleBarTextBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding HeaderTitle}" FontSize="12.5"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TitleBarMutedBrush}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Style="{StaticResource WindowButtonStyle}" Click="OnMinimizeClick" ToolTip="{loc:Loc Key='最小化到托盘'}">
                            <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" />
                        </Button>
                        <Button Style="{StaticResource WindowButtonStyle}" Click="OnMaximizeClick" ToolTip="{loc:Loc Key='最大化 / 还原'}">
                            <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Style="{StaticResource IconPath}" Width="13" Height="13" />
                        </Button>
                        <Button Style="{StaticResource CloseWindowButtonStyle}" Click="OnCloseClick" ToolTip="{loc:Loc Key='关闭到托盘'}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="264" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧栏 -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="16,18,16,14" Padding="16,14" CornerRadius="14"
                                Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFlame}" Style="{StaticResource IconPath}"
                                          Width="13" Height="13" Stroke="#FBBF24" />
                                    <TextBlock Text="{loc:Loc Key='今日进度'}" FontSize="11.5" Margin="7,0,0,0"
                                               Foreground="{DynamicResource SidebarMutedBrush}" />
                                </StackPanel>
                                <Grid Margin="0,14,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TodayCompleted}" FontSize="24" FontWeight="Bold"
                                                   Foreground="White" />
                                        <TextBlock Text="{loc:Loc Key='今日完成'}" FontSize="10.5" Margin="0,2,4,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource SidebarMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding OpenTasks}" FontSize="24" FontWeight="Bold"
                                                   Foreground="White" />
                                        <TextBlock Text="{loc:Loc Key='待办任务'}" FontSize="10.5" Margin="0,2,4,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource SidebarMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding StreakDays}" FontSize="24" FontWeight="Bold"
                                                   Foreground="White" />
                                        <TextBlock Text="{loc:Loc Key='连续天数'}" FontSize="10.5" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource SidebarMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="12,0">
                            <Button Style="{StaticResource NavButtonStyle}" Margin="0,2"
                                    Background="{Binding IsTodayActive, Converter={StaticResource ActiveBackground}}"
                                    Foreground="{Binding IsTodayActive, Converter={StaticResource ActiveForeground}}"
                                    Command="{Binding NavigateTodayCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconCalendar}" Style="{StaticResource IconPathLight}"
                                          Width="17" Height="17" />
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Key='今天'}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Margin="0,2"
                                    Background="{Binding IsAllActive, Converter={StaticResource ActiveBackground}}"
                                    Foreground="{Binding IsAllActive, Converter={StaticResource ActiveForeground}}"
                                    Command="{Binding NavigateAllCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconAll}" Style="{StaticResource IconPathLight}"
                                          Width="17" Height="17" />
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Key='全部任务'}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Margin="0,2"
                                    Background="{Binding IsHistoryActive, Converter={StaticResource ActiveBackground}}"
                                    Foreground="{Binding IsHistoryActive, Converter={StaticResource ActiveForeground}}"
                                    Command="{Binding NavigateHistoryCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconHistory}" Style="{StaticResource IconPathLight}"
                                          Width="17" Height="17" />
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Key='历史记录'}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="26,20,16,8">
                            <TextBlock Text="{loc:Loc Key='我的清单'}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarMutedBrush}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource SidebarIconButtonStyle}"
                                    Command="{Binding AddGroupCommand}" ToolTip="{loc:Loc Key='新建清单'}">
                                <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPathLight}"
                                      Width="14" Height="14" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,0">
                                <Button Style="{StaticResource NavButtonStyle}" Margin="8,2"
                                        Background="{Binding IsAllGroupsActive, Converter={StaticResource ActiveBackground}}"
                                        Foreground="{Binding IsAllGroupsActive, Converter={StaticResource ActiveForeground}}"
                                        Command="{Binding SelectAllGroupsCommand}"
                                        ToolTip="{loc:Loc Key='查看所有清单中的任务'}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{DynamicResource CyanBrush}"
                                                 Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{loc:Loc Key='所有清单'}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2" CornerRadius="8" Background="#22FFFFFF"
                                                Padding="7,1" VerticalAlignment="Center"
                                                Visibility="{Binding OpenTasks, Converter={StaticResource CountToVisibility}}">
                                            <TextBlock Text="{Binding OpenTasks}" FontSize="11"
                                                       Foreground="#C9D1EA" />
                                        </Border>
                                    </Grid>
                                </Button>
                                <ItemsControl ItemsSource="{Binding Groups}" Margin="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButtonStyle}" Margin="8,2"
                                                Background="{Binding IsSelected, Converter={StaticResource ActiveBackground}}"
                                                Foreground="{Binding IsSelected, Converter={StaticResource ActiveForeground}}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Loc Key='重命名清单'}"
                                                              Command="{Binding PlacementTarget.Tag.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding IsInbox, Converter={StaticResource BoolToInverse}}" />
                                                    <MenuItem Header="{loc:Loc Key='删除清单'}"
                                                              Command="{Binding PlacementTarget.Tag.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding IsInbox, Converter={StaticResource BoolToInverse}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="9" Height="9" Fill="{Binding ColorBrush}"
                                                         Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" CornerRadius="8" Background="#22FFFFFF"
                                                        Padding="7,1" VerticalAlignment="Center"
                                                        Visibility="{Binding Count, Converter={StaticResource CountToVisibility}}">
                                                    <TextBlock Text="{Binding Count}" FontSize="11"
                                                               Foreground="#C9D1EA" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="4" Margin="12,6,12,16">
                            <Border Height="1" Background="#20FFFFFF" Margin="4,0,4,8" />
                            <Button Style="{StaticResource NavButtonStyle}" Margin="0,2"
                                    Background="{Binding IsSettingsActive, Converter={StaticResource ActiveBackground}}"
                                    Foreground="{Binding IsSettingsActive, Converter={StaticResource ActiveForeground}}"
                                    Command="{Binding NavigateSettingsCommand}" ToolTip="{loc:Loc Key='音效与完成特效设置'}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPathLight}"
                                          Width="16" Height="16" />
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Key='设置'}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBlock Text="{loc:Loc Key='数据仅保存在本机 · 完全离线'}" FontSize="10.5" Margin="14,10,0,0"
                                       TextWrapping="Wrap" Foreground="#6C779C" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding CurrentView}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:MainViewModel}">
                                <views:HomeView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                                <views:HistoryView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <views:SettingsView />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>

        <!-- 编辑 / 确认遮罩 -->
        <views:EditorOverlay DataContext="{Binding Editor}" Panel.ZIndex="60"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- 底部撤销提示条 -->
        <Border Panel.ZIndex="70" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,26" Background="#1D2340" CornerRadius="12" Padding="16,11"
                Effect="{DynamicResource ShadowLarge}"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="20" Height="20" CornerRadius="10" Background="#3DDC97" Margin="0,0,10,0">
                    <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPathWhite}"
                          Width="11" Height="11" StrokeThickness="2.8" />
                </Border>
                <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="12.5"
                           VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                <Button Content="{loc:Loc Key='撤销'}" Style="{StaticResource TextButtonStyle}" Margin="16,0,4,0"
                        Foreground="#8AB4FF" Command="{Binding UndoCommand}"
                        Visibility="{Binding CanUndoToast, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource ContentIconButtonStyle}" Width="24" Height="24"
                        Command="{Binding DismissToastCommand}">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="12" Height="12"
                          Stroke="#AEB7D0" />
                </Button>
            </StackPanel>
        </Border>

        <!-- 完成仪式全屏层 -->
        <views:CelebrationOverlay x:Name="Celebration" Panel.ZIndex="90"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
</Window>
