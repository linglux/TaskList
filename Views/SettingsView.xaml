<UserControl x:Class="TaskList.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TaskList.Helpers"
             Background="{DynamicResource ContentBrush}">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="44" Height="26" CornerRadius="13" Background="#CBD0DC"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EffectChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Padding="16" CornerRadius="12" Background="#F7F8FC"
                                BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1.5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="#F0EEFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,28,34,24">
            <TextBlock Text="{loc:Loc Key='设置'}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{loc:Loc Key='把每一次完成，变成属于你的庆祝'}" FontSize="12.5" Margin="0,7,0,22"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key='语言'}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Loc Key='切换后立即生效，设置会自动保存。'}" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Code" DisplayMemberPath="Name"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                              HorizontalAlignment="Left" MinWidth="220" Padding="10,8" Margin="0,14,0,0"
                              AutomationProperties.Name="{loc:Loc Key='界面语言'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="{loc:Loc Key='完成音效'}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Key='为轻型、中型、重型任务分别选择一段声音'}" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" Style="{StaticResource SettingsToggle}"
                                  IsChecked="{Binding SoundEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="{loc:Loc Key='开启完成音效'}" ToolTip="{loc:Loc Key='开启或关闭完成音效'}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Sounds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FC" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                                       FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <WrapPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                                            <Button Content="{loc:Loc Key='选择 MP3'}" Style="{StaticResource GhostButtonStyle}" Padding="11,8" FontSize="12"
                                                    Command="{Binding DataContext.ImportSoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{loc:Loc Key='试听'}" Margin="7,0,0,0" Padding="11,8" FontSize="12"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding DataContext.PreviewSoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{loc:Loc Key='恢复默认'}" Margin="10,0,0,0" Padding="0,8" FontSize="11.5"
                                                    Style="{StaticResource TextButtonStyle}"
                                                    Command="{Binding DataContext.ResetSoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Key='仅支持不超过 10 秒的 MP3；导入后移动或删除原文件不影响使用。'}"
                               FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{loc:Loc Key='试听不受总开关影响，新声音会替换当前声音。'}" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        <Button Content="{loc:Loc Key='停止试听'}" HorizontalAlignment="Right" Padding="0,4" Margin="0,8,0,0"
                                Style="{StaticResource TextButtonStyle}" Command="{Binding StopSoundCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key='完成特效'}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Loc Key='统一使用所选风格，任务越重，庆祝越隆重'}" FontSize="12" Margin="0,6,0,18"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Style="{StaticResource EffectChoice}" GroupName="CompletionEffect" Margin="0,0,8,0"
                                     AutomationProperties.Name="{loc:Loc Key='原有分级特效'}"
                                     IsChecked="{Binding SelectedEffect, Converter={StaticResource EqualityToBool}, ConverterParameter=Original}">
                            <StackPanel>
                                <Path Data="{StaticResource IconSparkle}" Style="{StaticResource IconPath}" HorizontalAlignment="Left"
                                      Stroke="{DynamicResource AccentBrush}" Width="26" Height="26" Margin="0,0,0,14" />
                                <TextBlock Text="{loc:Loc Key='原有分级特效'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Key='从轻快纸屑到成就卡片，再到全屏庆祝，保留熟悉的完成仪式。'}"
                                           FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Style="{StaticResource EffectChoice}" GroupName="CompletionEffect" Margin="8,0,0,0"
                                     AutomationProperties.Name="{loc:Loc Key='鼓掌特效'}"
                                     IsChecked="{Binding SelectedEffect, Converter={StaticResource EqualityToBool}, ConverterParameter=Applause}">
                            <StackPanel>
                                <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" HorizontalAlignment="Left"
                                      Stroke="#E59A28" Width="26" Height="26" Margin="0,0,0,14" />
                                <TextBlock Text="{loc:Loc Key='为你鼓掌'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Key='拍合的双手、喝彩波纹与缤纷彩带，每一件完成都值得被看见。'}"
                                           FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Row="1" Style="{StaticResource EffectChoice}" GroupName="CompletionEffect" Margin="0,16,8,0"
                                     AutomationProperties.Name="{loc:Loc Key='极简勾选特效'}"
                                     IsChecked="{Binding SelectedEffect, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=MinimalCheck}">
                            <StackPanel>
                                <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" HorizontalAlignment="Left"
                                      Stroke="#059669" Width="26" Height="26" Margin="0,0,0,14" />
                                <TextBlock Text="{loc:Loc Key='极简勾选'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Key='一笔勾选、轻盈回弹与细波纹，利落确认，不打断你的专注。'}"
                                           FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Row="1" Grid.Column="1" Style="{StaticResource EffectChoice}" GroupName="CompletionEffect" Margin="8,16,0,0"
                                     AutomationProperties.Name="{loc:Loc Key='完成印章特效'}"
                                     IsChecked="{Binding SelectedEffect, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=CompletionStamp}">
                            <StackPanel>
                                <Path Data="M 13,2 A 11,11 0 1 1 12.9,2 M 13,5 A 8,8 0 1 1 12.9,5 M 9,9 L 17,9 M 9,13 L 17,13 M 9,17 L 17,17 M 13,9 L 13,17"
                                      Style="{StaticResource IconPath}" HorizontalAlignment="Left" Stroke="#851C22"
                                      Width="26" Height="26" Margin="0,0,0,14" />
                                <TextBlock Text="{loc:Loc Key='完成印章'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Key='深红圆印、仿篆刻字形与斑驳印泥，盖下属于这件事的收官印痕。'}"
                                           FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Row="2" Style="{StaticResource EffectChoice}" GroupName="CompletionEffect" Margin="0,16,8,0"
                                     AutomationProperties.Name="{loc:Loc Key='星光汇聚特效'}"
                                     IsChecked="{Binding SelectedEffect, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=Starlight}">
                            <StackPanel>
                                <Path Data="M 3,18 L 7,8 L 15,4 L 23,12 L 18,22 M 7,8 L 18,22 M 2,18 L 4,18 M 6,8 L 8,8 M 14,4 L 16,4 M 22,12 L 24,12 M 17,22 L 19,22"
                                      Style="{StaticResource IconPath}" HorizontalAlignment="Left"
                                      Stroke="#0284C7" Width="26" Height="26" Margin="0,0,0,14" />
                                <TextBlock Text="{loc:Loc Key='星光汇聚'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Key='逐颗点亮星座、描出连线，最后亮起金色主星，让完成拥有自己的光芒。'}"
                                           FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Row="2" Grid.Column="1" Style="{StaticResource EffectChoice}" GroupName="CompletionEffect" Margin="8,16,0,0"
                                     AutomationProperties.Name="{loc:Loc Key='礼花绽放特效'}"
                                     IsChecked="{Binding SelectedEffect, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=Fireworks}">
                            <StackPanel>
                                <Path Data="M 13,2 L 13,8 M 13,18 L 13,24 M 2,13 L 8,13 M 18,13 L 24,13 M 5,5 L 9,9 M 17,17 L 21,21 M 5,21 L 9,17 M 17,9 L 21,5"
                                      Style="{StaticResource IconPath}" HorizontalAlignment="Left" Stroke="#7C3AED"
                                      Width="26" Height="26" Margin="0,0,0,14" />
                                <TextBlock Text="{loc:Loc Key='礼花绽放'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Key='两朵、四朵、六朵礼花分波升空，双层绽放与明亮长拖尾，为完成隆重喝彩。'}"
                                           FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <WrapPanel Margin="0,18,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key='预览强度'}" FontSize="12" Margin="0,8,12,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <RadioButton Content="{loc:Loc Key='轻型'}" GroupName="PreviewWeight" Style="{StaticResource WeightRadioStyle}" Margin="0,0,5,0"
                                     IsChecked="{Binding PreviewWeight, Converter={StaticResource EqualityToBool}, ConverterParameter=Light}" />
                        <RadioButton Content="{loc:Loc Key='中型'}" GroupName="PreviewWeight" Style="{StaticResource WeightRadioStyle}" Margin="0,0,5,0"
                                     IsChecked="{Binding PreviewWeight, Converter={StaticResource EqualityToBool}, ConverterParameter=Medium}" />
                        <RadioButton Content="{loc:Loc Key='重型'}" GroupName="PreviewWeight" Style="{StaticResource WeightRadioStyle}" Margin="0,0,14,0"
                                     IsChecked="{Binding PreviewWeight, Converter={StaticResource EqualityToBool}, ConverterParameter=Heavy}" />
                        <Button Content="{loc:Loc Key='预览特效'}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8"
                                Command="{Binding PreviewEffectCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Loc Key='预览只展示视觉效果，不会完成任务或产生历史记录。'}" FontSize="11" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="#EEEFFE" CornerRadius="12" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentDeepBrush}" />
                    <Button Content="{loc:Loc Key='取消导入'}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Style="{StaticResource TextButtonStyle}" Command="{Binding CancelImportCommand}"
                            Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{loc:Loc Key='音频保存目录（备份时请一起复制）：'}" FontSize="11" Margin="0,14,0,4"
                       Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SoundsDirectory}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
